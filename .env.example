PASSWORD_RESET_EMAIL=your-email@example.com
SMS_REMINDER_CHECK_INTERVAL_MS=3600000
MOCEAN_API_TOKEN=your-mocean-api-token
MOCEAN_FROM=<approved-sender-id>
CRON_SECRET=<long-random-secret>
